<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootPane" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.mycompany.juegomemoria.HistorialPartidasController" minWidth="800" minHeight="600">
    
    <ImageView fx:id="backgroundImageView" preserveRatio="false" StackPane.alignment="CENTER">
        <image>
            <Image url="@imagenes/fondoDePersonajes.jpg" />
        </image>
    </ImageView>

    <BorderPane fx:id="mainContentPane">
        <top>
            <VBox spacing="10.0" alignment="CENTER">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="10.0" left="20.0" />
                </padding>
                <Label text="Historial de Partidas" styleClass="title-label">
                    <font>
                        <Font size="28.0" />
                    </font>
                </Label>
            </VBox>
        </top>
        
        <center>
            <StackPane alignment="CENTER" minHeight="200">
                <ScrollPane fx:id="scrollPane" fitToWidth="true" fitToHeight="true" maxHeight="400">
                    <ListView fx:id="partidasListView" styleClass="historial-list" />
                </ScrollPane>
                <Label fx:id="mensajeLabel" text="No hay partidas guardadas" styleClass="sidebar-label" visible="false" alignment="CENTER" />
            </StackPane>
        </center>
        
        <bottom>
            <HBox spacing="20.0" alignment="CENTER">
                <padding>
                    <Insets top="10.0" right="40.0" bottom="20.0" left="40.0" />
                </padding>
                
                <Button fx:id="volverButton" mnemonicParsing="false" onAction="#handleVolver" 
                        styleClass="menu-button" text="Volver al Menú" minWidth="150" minHeight="40" />
                
                <Button fx:id="jugarButton" mnemonicParsing="false" onAction="#handleJugarPartida" 
                        styleClass="menu-button" text="Jugar Partida Seleccionada" minWidth="200" minHeight="40" />
            </HBox>
        </bottom>
    </BorderPane>
</StackPane> 